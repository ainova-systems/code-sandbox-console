{
  "name": "sandbox-console",
  "displayName": "Sandbox Console",
  "description": "Run AI coding agents (Claude Code, Codex, Gemini, …) in isolated, persistent Docker Sandboxes (sbx microVMs) — terminal-first, from a Sandbox Explorer, with no manual container management.",
  "version": "0.2.0",
  "publisher": "ainova-systems",
  "license": "MIT",
  "author": {
    "name": "MB Ainova Systems",
    "url": "https://www.ainovasystems.com"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "docker",
    "sandbox",
    "sbx",
    "microvm",
    "claude",
    "agent",
    "terminal",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ainova-systems/code-sandbox-console.git"
  },
  "homepage": "https://github.com/ainova-systems/code-sandbox-console#readme",
  "bugs": {
    "url": "https://github.com/ainova-systems/code-sandbox-console/issues"
  },
  "qna": "https://github.com/ainova-systems/code-sandbox-console/issues",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1F2430",
    "theme": "dark"
  },
  "preview": true,
  "pricing": "Free",
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Sandbox Console executes sbx CLI commands derived from the workspace's committed .sandbox/config.yaml, so it only runs in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Sandbox Console needs a real filesystem and the local sbx CLI, which are unavailable in virtual workspaces."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sandboxConsole.attach",
        "title": "Connect",
        "category": "Sandbox"
      },
      {
        "command": "sandboxConsole.stop",
        "title": "Stop",
        "category": "Sandbox"
      },
      {
        "command": "sandboxConsole.openShell",
        "title": "Shell",
        "category": "Sandbox"
      },
      {
        "command": "sandboxConsole.rebuild",
        "title": "Rebuild",
        "category": "Sandbox"
      },
      {
        "command": "sandboxConsole.pickSandbox",
        "title": "Switch Sandbox",
        "category": "Sandbox"
      },
      {
        "command": "sandboxConsole.newSandbox",
        "title": "New Sandbox",
        "category": "Sandbox",
        "icon": "$(add)"
      },
      {
        "command": "sandboxConsole.manageSecrets",
        "title": "Manage Cached Secrets",
        "category": "Sandbox"
      },
      {
        "command": "sandboxConsole.refresh",
        "title": "Refresh",
        "category": "Sandbox",
        "icon": "$(refresh)"
      },
      {
        "command": "sandboxConsole.item.attach",
        "title": "Connect",
        "category": "Sandbox",
        "icon": "$(plug)"
      },
      {
        "command": "sandboxConsole.item.stop",
        "title": "Stop",
        "category": "Sandbox",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sandboxConsole.item.shell",
        "title": "Shell",
        "category": "Sandbox",
        "icon": "$(terminal-bash)"
      },
      {
        "command": "sandboxConsole.item.rebuild",
        "title": "Rebuild",
        "category": "Sandbox",
        "icon": "$(tools)"
      },
      {
        "command": "sandboxConsole.item.edit",
        "title": "Edit",
        "category": "Sandbox",
        "icon": "$(edit)"
      },
      {
        "command": "sandboxConsole.item.destroy",
        "title": "Delete instance",
        "category": "Sandbox",
        "icon": "$(trash)"
      },
      {
        "command": "sandboxConsole.item.remove",
        "title": "Remove from config",
        "category": "Sandbox",
        "icon": "$(close)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "sandboxConsoleExplorer",
          "name": "Sandboxes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sandboxConsoleExplorer",
        "contents": "No sandboxes yet for this repo.\n[New Sandbox](command:sandboxConsole.newSandbox)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sandboxConsole.item.attach",
          "when": "false"
        },
        {
          "command": "sandboxConsole.item.stop",
          "when": "false"
        },
        {
          "command": "sandboxConsole.item.shell",
          "when": "false"
        },
        {
          "command": "sandboxConsole.item.rebuild",
          "when": "false"
        },
        {
          "command": "sandboxConsole.item.edit",
          "when": "false"
        },
        {
          "command": "sandboxConsole.item.destroy",
          "when": "false"
        },
        {
          "command": "sandboxConsole.item.remove",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sandboxConsole.newSandbox",
          "when": "view == sandboxConsoleExplorer",
          "group": "navigation@1"
        },
        {
          "command": "sandboxConsole.refresh",
          "when": "view == sandboxConsoleExplorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sandboxConsole.item.stop",
          "when": "view == sandboxConsoleExplorer && viewItem == sandbox.running",
          "group": "inline@1"
        },
        {
          "command": "sandboxConsole.item.attach",
          "when": "view == sandboxConsoleExplorer && viewItem =~ /^sandbox\\./",
          "group": "inline@2"
        },
        {
          "command": "sandboxConsole.item.edit",
          "when": "view == sandboxConsoleExplorer && (viewItem == sandbox.stopped || viewItem == sandbox.absent)",
          "group": "inline@4"
        },
        {
          "command": "sandboxConsole.item.destroy",
          "when": "view == sandboxConsoleExplorer && viewItem == sandbox.stopped",
          "group": "inline@5"
        },
        {
          "command": "sandboxConsole.item.remove",
          "when": "view == sandboxConsoleExplorer && viewItem == sandbox.absent",
          "group": "inline@6"
        },
        {
          "command": "sandboxConsole.item.attach",
          "when": "view == sandboxConsoleExplorer && viewItem =~ /^sandbox\\./",
          "group": "1_run@1"
        },
        {
          "command": "sandboxConsole.item.shell",
          "when": "view == sandboxConsoleExplorer && viewItem == sandbox.running",
          "group": "1_run@2"
        },
        {
          "command": "sandboxConsole.item.stop",
          "when": "view == sandboxConsoleExplorer && viewItem == sandbox.running",
          "group": "1_run@3"
        },
        {
          "command": "sandboxConsole.item.edit",
          "when": "view == sandboxConsoleExplorer && (viewItem == sandbox.stopped || viewItem == sandbox.absent)",
          "group": "2_config@1"
        },
        {
          "command": "sandboxConsole.item.rebuild",
          "when": "view == sandboxConsoleExplorer && viewItem == sandbox.stopped",
          "group": "2_config@2"
        },
        {
          "command": "sandboxConsole.item.destroy",
          "when": "view == sandboxConsoleExplorer && viewItem == sandbox.stopped",
          "group": "3_danger@1"
        },
        {
          "command": "sandboxConsole.item.remove",
          "when": "view == sandboxConsoleExplorer && viewItem == sandbox.absent",
          "group": "3_danger@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "install-extension": "vsce package -o sandbox-console.vsix && code --install-extension sandbox-console.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
